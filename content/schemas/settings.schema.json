{
  "$defs": {
    "hook": {
      "additionalProperties": false,
      "properties": {
        "allowed_env_vars": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Request headers of an http hook.",
          "type": "object"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_message": {
          "description": "Accepted; not shown."
        },
        "timeout": {
          "description": "Seconds.",
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "enum": [
            "command",
            "script",
            "http",
            "prompt",
            "agent"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "hookGroup": {
      "additionalProperties": false,
      "properties": {
        "hooks": {
          "items": {
            "$ref": "#/$defs/hook"
          },
          "type": "array"
        },
        "matcher": {
          "description": "A regex over the subject; empty or * matches all.",
          "type": "string"
        }
      },
      "required": [
        "hooks"
      ],
      "type": "object"
    },
    "languageServer": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "command": {
          "description": "Program to start.",
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "description": "true removes the server.",
          "type": "boolean"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "extensionToLanguage": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "rootMarkers": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A settings.json, settings.local.json or managed-settings.json file of the app.",
  "properties": {
    "$schema": {
      "description": "The JSON Schema this file follows, for editors; the app ignores it.",
      "type": "string"
    },
    "advisorModel": {
      "description": "Model for the advisor the agent consults.",
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "description": "Runs the main conversation as this agent.",
      "type": [
        "string",
        "null"
      ]
    },
    "bashOutputLimit": {
      "default": 30000,
      "description": "Characters of a command's output the agent sees; past it, the start and the end are kept and the whole output is saved to a file the agent is pointed to.",
      "maximum": 1000000,
      "minimum": 1000,
      "type": "integer"
    },
    "disabledMcpServers": {
      "description": "Project MCP servers you turned off; wins over the approvals.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "enableAllProjectMcpServers": {
      "description": "Starts every MCP server the project's mcp.json declares without asking.",
      "type": "boolean"
    },
    "enabledMcpServers": {
      "description": "Project MCP servers you approved.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "escalationModel": {
      "description": "Where a call the agent keeps failing is sent. Read only from your own files.",
      "type": [
        "string",
        "null"
      ]
    },
    "fallbackModel": {
      "description": "Model, or chain of models, tried when the chosen one is unavailable.",
      "items": {
        "type": [
          "string",
          "null"
        ]
      },
      "type": [
        "string",
        "array",
        "null"
      ]
    },
    "hooks": {
      "additionalProperties": false,
      "description": "Commands, prompts or HTTP calls that run on events.",
      "properties": {
        "Brief": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "ModelError": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "ModelRequest": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "ModelResponse": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "Notification": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "PermissionRequest": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "PostCompact": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "PostToolUse": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "PostToolUseFailure": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "PreCompact": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "PreToolUse": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "RunEnd": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "RunStart": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "SessionEnd": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "SessionStart": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "Stop": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "SubagentStart": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "SubagentStop": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "TaskCompleted": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "TaskCreated": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "TeammateIdle": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        },
        "UserPromptSubmit": {
          "items": {
            "$ref": "#/$defs/hookGroup"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "jsonSchema": {
      "description": "Gives the agent a StructuredOutput tool whose result must match this JSON Schema.",
      "type": [
        "object",
        "boolean",
        "null"
      ]
    },
    "judgeModel": {
      "description": "Model for the judge that checks finished work.",
      "type": [
        "string",
        "null"
      ]
    },
    "lspServers": {
      "additionalProperties": {
        "$ref": "#/$defs/languageServer"
      },
      "description": "Adds, changes or disables language servers, by name.",
      "type": "object"
    },
    "outputStyle": {
      "description": "How the agent talks: a built-in style (default, concise, proactive, explanatory, learning) or the name of a custom style in output-styles/<name>.md.",
      "type": "string"
    },
    "permissions": {
      "additionalProperties": false,
      "description": "Extra folders.",
      "properties": {
        "additionalDirectories": {
          "description": "Folders the agent reads like the project. Read only from your own files.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "scripts": {
      "additionalProperties": false,
      "description": "What JavaScript tools, skills, hooks and providers may do.",
      "properties": {
        "files": {
          "description": "Scripts may read and write files.",
          "type": "boolean"
        },
        "network": {
          "description": "Scripts may reach the network.",
          "type": "boolean"
        },
        "processes": {
          "description": "Scripts may start processes.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "smallModel": {
      "description": "Model for background chores: titles, effort picks, web reading.",
      "type": [
        "string",
        "null"
      ]
    },
    "teammateMode": {
      "default": "process",
      "description": "Where a lead starts its teammates: process (in the background, printing to a log), tmux (in a new tmux pane of the window the lead runs in), iterm2 (in a new iTerm2 pane beside the lead) or auto (tmux inside tmux, else iTerm2 inside iTerm2, else process).",
      "enum": [
        "process",
        "tmux",
        "iterm2",
        "auto"
      ]
    }
  },
  "title": "Settings",
  "type": "object"
}
