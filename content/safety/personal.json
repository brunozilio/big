{
  "schema_version": 1,
  "patterns": [
    { "name": "email", "regex": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$" },
    { "name": "cpf", "regex": "^\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}$" },
    { "name": "cnpj", "regex": "^\\d{2}\\.?\\d{3}\\.?\\d{3}/?\\d{4}-?\\d{2}$" },
    { "name": "card", "regex": "^\\d{4}[ -]?\\d{4}[ -]?\\d{4}[ -]?\\d{4}$" },
    { "name": "phone", "regex": "^\\+\\d{10,15}$" },
    { "name": "ipv4", "regex": "^(\\d{1,3}\\.){3}\\d{1,3}$" }
  ]
}
