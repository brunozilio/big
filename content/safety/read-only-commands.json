{
  "sensitive": [
    "secret",
    "credential",
    "password",
    "passwd",
    "token",
    "apikey",
    "api_key",
    "api-key",
    "private",
    ".env",
    ".pem",
    ".key",
    ".p12",
    ".pfx",
    "id_rsa",
    "id_ed25519",
    "id_ecdsa",
    ".netrc",
    ".npmrc",
    ".pypirc",
    ".pgpass",
    "kubeconfig",
    "shadow"
  ],
  "commands": [
    { "name": "ls" },
    { "name": "pwd" },
    { "name": "cat" },
    { "name": "head" },
    { "name": "tail", "refused": ["-f", "-F", "--follow", "--retry"] },
    { "name": "wc" },
    { "name": "grep" },
    { "name": "rg", "refused": ["--pre", "--pre-glob", "--search-zip", "-z"] },
    { "name": "find", "refused": ["-exec", "-execdir", "-ok", "-okdir", "-delete", "-fprint", "-fls"] },
    { "name": "tree", "refused": ["-o", "-R"] },
    { "name": "stat" },
    { "name": "du" },
    { "name": "file", "refused": ["-C", "--compile"] },
    { "name": "which" },
    { "name": "basename" },
    { "name": "dirname" },
    { "name": "realpath" },
    { "name": "sort", "refused": ["-o", "--output", "--compress-program"] },
    { "name": "cut" },
    { "name": "diff" },
    {
      "name": "git",
      "subcommands": ["status", "log", "diff", "show", "blame", "rev-parse", "ls-files", "shortlog"],
      "refused": ["--output", "--ext-diff", "--textconv", "--no-index"]
    }
  ]
}
